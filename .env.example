# Copy to .env only if you want to change defaults. Everything works without a .env file.
# .env is git-ignored and excluded from the Docker build context.

# demo = recorded synthetic model responses, no key, no network.
# live = real calls to the Anthropic Messages API (needs LLM_API_KEY created for this project).
MODEL_MODE=demo

# Live mode only. Leave empty for demo. Never commit a real key.
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=0

# Retrieval (PostgreSQL full-text search)
RETRIEVAL_TOP_K=4
# A section must match at least this many distinct query terms (overlap rule).
RETRIEVAL_MIN_TERMS=2
RETRIEVAL_MAX_CHARS=1500

# Seconds added to the timeout before a RUNNING attempt counts as expired (crash recovery).
ATTEMPT_GRACE_SECONDS=10

# Host port for the UI/API (bound to 127.0.0.1 only).
APP_PORT=8091
POSTGRES_PASSWORD=triage-local-only
